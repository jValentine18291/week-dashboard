# Copy this file to .env and fill in your own values.
# Never commit .env — it holds secrets.

# --- access ---
# Password you type to open the dashboard. Leave blank ONLY for local testing.
DASHBOARD_PASSWORD=
# Any long random string. Used to sign the login cookie.
COOKIE_SECRET=

# --- timezone ---
TIMEZONE=Asia/Singapore

# --- Google Calendar ---
# Google Calendar > Settings > (your calendar) > "Secret address in iCal format"
# Treat this URL as a password: anyone holding it can read your calendar.
GOOGLE_CALENDAR_ICS_URL=

# --- Notion ---
# notion.so/my-integrations > new internal integration > copy the secret
NOTION_TOKEN=
# Open the database full-page > Database settings > Manage data sources > ... > Copy data source ID
NOTION_TASKS_DATA_SOURCE_ID=
NOTION_NOTES_DATA_SOURCE_ID=

# --- Assistant (optional) ---
# Leave blank to disable the chat drawer entirely; the rest of the app is
# unaffected. This relay is NEVER given your calendar, tasks or notes.
# platform.openai.com > API keys
OPENAI_API_KEY=
# Model name. Check the provider's current list — these change over time.
OPENAI_MODEL=gpt-4o-mini
# Only set these to point at a different OpenAI-compatible endpoint.
OPENAI_BASE_URL=
OPENAI_MAX_TOKENS=800

# --- Notion column names (change only if yours differ) ---
NOTION_DUE_PROPERTY=Due
NOTION_STATUS_PROPERTY=Status
NOTION_AREA_PROPERTY=Area
NOTION_PRIORITY_PROPERTY=Priority
NOTION_DONE_VALUES=Done,Complete,Completed
