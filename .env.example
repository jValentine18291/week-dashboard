# Copy this file to .env and fill in your own values.
# Never commit .env — it holds secrets.

# --- access ---
# Password you type to open the dashboard. Leave blank ONLY for local testing.
DASHBOARD_PASSWORD=
# Any long random string. Used to sign the login cookie.
COOKIE_SECRET=

# --- timezone ---
TIMEZONE=Asia/Singapore

# --- Google Calendar ---
# Google Calendar > Settings > (your calendar) > "Secret address in iCal format"
# Treat this URL as a password: anyone holding it can read your calendar.
GOOGLE_CALENDAR_ICS_URL=

# --- Notion ---
# notion.so/my-integrations > new internal integration > copy the secret
NOTION_TOKEN=
# Open the database full-page > Database settings > Manage data sources > ... > Copy data source ID
NOTION_TASKS_DATA_SOURCE_ID=
NOTION_NOTES_DATA_SOURCE_ID=

# --- Assistant (optional) ---
# Leave blank to disable the chat drawer entirely; the rest of the app is
# unaffected. This relay is NEVER given your calendar, tasks or notes.
#
# Works with any OpenAI-compatible endpoint. Pick ONE of the two below.
#
# OPTION A — Google Gemini. Has a genuinely free tier, no card required.
#   Key from aistudio.google.com/apikey
#   OPENAI_API_KEY=<your Gemini key>
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OPENAI_MODEL=gemini-3.1-flash-lite
#
# OPTION B — OpenAI. Billed per message, prepaid; a ChatGPT subscription
#   does NOT cover it. Key from platform.openai.com/api-keys
#   OPENAI_API_KEY=<your OpenAI key>
#   OPENAI_BASE_URL=
#   OPENAI_MODEL=gpt-4o-mini
#
# Model names change often — check the provider's current list.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_MAX_TOKENS=800

# --- Notion column names (change only if yours differ) ---
NOTION_DUE_PROPERTY=Due
NOTION_STATUS_PROPERTY=Status
NOTION_AREA_PROPERTY=Area
NOTION_PRIORITY_PROPERTY=Priority
NOTION_DONE_VALUES=Done,Complete,Completed

# --- News (optional) ---
# Comma-separated RSS feed URLs. Blank uses the shipped pair:
# CNA Singapore + BBC World.
NEWS_FEEDS=

# --- Work email (optional) ---
# Gmail, read-only and metadata-only: headers and labels, never message bodies.
# Leave GMAIL_REFRESH_TOKEN blank to switch the Mail page off entirely.
# 1. console.cloud.google.com > enable Gmail API > OAuth client (Desktop app)
# 2. node get-gmail-token.js   <- prints the refresh token in your terminal
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_LIMIT=8
